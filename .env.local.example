# Supabase 配置
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
# 服务端写库密钥（虚拟支付订单表开了 RLS，anon 无权限，必须用 service_role）
# Supabase 后台 → Project Settings → API → service_role secret
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# 管理员设置密钥（用于访问 /admin/setup 页面）
# 生成建议: openssl rand -base64 32
SETUP_SECRET_KEY=your_secure_random_key_here

# 微信小程序（同一小程序的 appid/secret，内容安全检测与虚拟支付共用）
WX_APPID=your_miniprogram_appid
WX_SECRET=your_miniprogram_secret

# 小程序消息推送（/api/wx/push）
WX_MSG_TOKEN=BeeOfYangjingMsg2026
# 仅在「兼容模式 / 安全模式」下需要，明文模式可留空
WX_MSG_AES_KEY=

# 虚拟支付（MP 后台 → 虚拟支付 → 基本配置）
# 三项都填好后 /api/wx/xpay-* 才会生效；缺任意一项前端会提示「功能准备中」
WX_XPAY_OFFER_ID=your_offer_id
WX_XPAY_APP_KEY=your_production_app_key
WX_XPAY_APP_KEY_SANDBOX=your_sandbox_app_key
# 0=正式环境（现网只能填 0） 1=沙箱环境
WX_XPAY_ENV=0
# 道具不在这里配置：道具 ID 与价格在 src/lib/wx-xpay.ts 的 XPAY_PRODUCTS 注册表中维护
# （端上下单只传 productId，价格以服务端注册表为准，支持任意多个道具）

# 开发者售出通知（可选）：企业微信群机器人 Webhook，留空则关闭
# 创建方式：企业微信群 → 群设置 → 群机器人 → 添加 → 复制 Webhook URL
# 发货成功后会自动给群里推一条 markdown 通知
DEV_WECHAT_WORK_WEBHOOK=
